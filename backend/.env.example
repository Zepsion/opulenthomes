# ===================================
# SERVER CONFIGURATION
# ===================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ===================================
# DATABASE
# ===================================
MONGODB_URI=mongodb://127.0.0.1:27017/opulent_homes
MONGODB_URI_PROD=your_mongodb_atlas_connection_string

# ===================================
# JWT AUTHENTICATION
# ===================================
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRY=7d
JWT_COOKIE_EXPIRY_DAYS=7

# ===================================
# CLOUDINARY (Media Storage)
# ===================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=opulent-homes

# ===================================
# SECURITY
# ===================================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# ADMIN SEED (used only by seed script)
# ===================================
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@opulenthomes.com
SEED_ADMIN_PASSWORD=Zepsion98@
